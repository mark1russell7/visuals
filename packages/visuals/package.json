{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/visuals",
  "version": "0.3.8",
  "description": "3D stages for data on three.js: a camera that a person moves, views by name, picking, highlights and themes, a globe of the Earth, and the shared marks of the viewers as data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/visuals.git",
    "directory": "packages/visuals"
  },
  "homepage": "https://mark1russell7.github.io/visuals/",
  "bugs": {
    "url": "https://github.com/mark1russell7/visuals/issues"
  },
  "keywords": [
    "3d",
    "three",
    "viewer",
    "camera",
    "orbit",
    "picking",
    "globe",
    "webgl",
    "marks",
    "labels"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./three": "./src/three.ts",
    "./globe": "./src/globe.ts",
    "./marks": "./src/marks.ts",
    "./markers": "./src/markers.ts",
    "./scrubber": "./src/scrubber.ts",
    "./scrubber.css": "./styles/scrubber.css",
    "./labels": "./src/labels.ts",
    "./labels.css": "./styles/labels.css",
    "./graph": "./src/graph.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/geo": "^0.5.0",
    "@mark1russell7/layout-contract": "^0.10.5"
  },
  "peerDependencies": {
    "three": ">=0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "three": "^0.187.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./three": {
        "types": "./build/three.d.ts",
        "import": "./build/three.js",
        "default": "./build/three.js"
      },
      "./globe": {
        "types": "./build/globe.d.ts",
        "import": "./build/globe.js",
        "default": "./build/globe.js"
      },
      "./marks": {
        "types": "./build/marks.d.ts",
        "import": "./build/marks.js",
        "default": "./build/marks.js"
      },
      "./markers": {
        "types": "./build/markers.d.ts",
        "import": "./build/markers.js",
        "default": "./build/markers.js"
      },
      "./scrubber": {
        "types": "./build/scrubber.d.ts",
        "import": "./build/scrubber.js",
        "default": "./build/scrubber.js"
      },
      "./scrubber.css": "./styles/scrubber.css",
      "./labels": {
        "types": "./build/labels.d.ts",
        "import": "./build/labels.js",
        "default": "./build/labels.js"
      },
      "./labels.css": "./styles/labels.css",
      "./graph": {
        "types": "./build/graph.d.ts",
        "import": "./build/graph.js",
        "default": "./build/graph.js"
      },
      "./package.json": "./package.json"
    }
  }
}
